---
import Icon from "./Icon.astro";
import { telHref } from "../lib/sanity";
import type { NavItem } from "../lib/nav";
import type { SiteSettings } from "../lib/types";

interface Props { settings: SiteSettings; nav: NavItem[]; }
const { settings, nav } = Astro.props;
const year = new Date().getFullYear();
const social = settings.socialLinks ?? [];
const address = settings.officeAddress?.trim();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="footer__name">{settings.agentName}</p>
        <p class="footer__meta">
          {settings.title && <>{settings.title}<br /></>}
          {settings.brokerage}
          {settings.licenseNumber && <><br />License #{settings.licenseNumber}</>}
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="footer__heading">Explore</p>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
      <div>
        <p class="footer__heading">Contact</p>
        <ul>
          <li><a href={telHref(settings.phone)}>{settings.phone}</a></li>
          <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
          {address && <li><address>{address}</address></li>}
        </ul>
      </div>
      {social.length > 0 && (
        <div>
          <p class="footer__heading">Follow</p>
          <ul>
            {social.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.platform}<Icon name="arrow-up-right" /></a></li>)}
          </ul>
        </div>
      )}
    </div>
    {settings.disclaimer && <div class="footer__legal"><p>{settings.disclaimer}</p></div>}
    <div class="footer__bottom">
      <p>© {year} {settings.agentName}</p>
      <a href="#top">Back to top<Icon name="arrow-up" /></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 6rem) 2rem;
    background: var(--color-dark-deep);
    color: var(--color-on-dark);
    font-size: 0.9375rem;
  }
  .footer__top { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 3rem 2rem; }
  .footer__top > :first-child { grid-column: 1 / -1; }
  @media (min-width: 960px) {
    .footer__top { grid-template-columns: minmax(0, 24rem) repeat(auto-fit, minmax(10rem, 1fr)); column-gap: clamp(2rem, 5vw, 5rem); }
    .footer__top > :first-child { grid-column: auto; }
  }

  .footer__name { margin: 0 0 1rem; font-family: var(--font-heading); font-size: 2.5rem; line-height: 1; }
  .footer__meta { margin: 0; color: var(--color-on-dark-muted); line-height: 1.7; }
  .footer__heading {
    margin: 0 0 1.25rem;
    color: var(--color-accent-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer ul { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .footer a { color: var(--color-on-dark); text-decoration: none; overflow-wrap: anywhere; transition: color 0.3s; }
  .footer a:hover { color: var(--color-accent-soft); }
  .footer li a, .footer__bottom a { display: inline-flex; align-items: center; gap: 0.375rem; }
  .footer :global(svg) { flex: none; width: 1em; height: 1em; }
  .footer address { color: var(--color-on-dark-muted); white-space: pre-line; text-wrap: pretty; }

  .footer__legal { margin-top: clamp(3.5rem, 6vw, 5rem); padding-top: 2rem; border-top: 1px solid var(--color-on-dark-border); }
  .footer__legal p {
    max-width: 90ch;
    margin: 0;
    color: var(--color-on-dark-muted);
    font-size: 0.8125rem;
    line-height: 1.7;
    white-space: pre-line;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-on-dark-border);
    color: var(--color-on-dark-muted);
    font-size: 0.8125rem;
  }
  .footer__top + .footer__bottom { margin-top: clamp(3.5rem, 6vw, 5rem); }
  .footer__bottom p { margin: 0; }
</style>
