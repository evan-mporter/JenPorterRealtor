---
import SanityImage from "./SanityImage.astro";
import { telHref } from "../lib/sanity";
import type { SiteSettings } from "../lib/types";

interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__brand">
      {settings.logo ? (
        <SanityImage image={settings.logo} widths={[160, 320]} sizes="160px" class="header__logo" loading="eager" />
      ) : (
        <span>{settings.agentName}</span>
      )}
    </a>
    <nav aria-label="Main">
      <ul class="header__nav">
        <li><a href="#about">About</a></li>
        <li><a href="#listings">Listings</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a class="header__phone" href={telHref(settings.phone)}>{settings.phone}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-border); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
  .header__brand { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--color-text); text-decoration: none; }
  .header__brand :global(.header__logo) { height: 40px; width: auto; }
  .header__nav { display: flex; gap: clamp(0.75rem, 2.5vw, 1.75rem); list-style: none; margin: 0; padding: 0; font-size: 0.95rem; }
  .header__nav a { color: var(--color-text); text-decoration: none; }
  .header__nav a:hover { color: var(--color-accent); }
  .header__phone { font-weight: 600; }
  @media (max-width: 640px) {
    .header__nav li:not(:last-child) { display: none; }
  }
</style>
