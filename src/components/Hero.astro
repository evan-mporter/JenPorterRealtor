---
import SanityImage from "./SanityImage.astro";
import Icon from "./Icon.astro";
import Marks from "./Marks.astro";
import type { LandingPage, SiteSettings } from "../lib/types";

interface Props { page: LandingPage; settings: SiteSettings; showListingsLink: boolean; }
const { page, settings, showListingsLink } = Astro.props;
const credits = [settings.agentName, settings.title, settings.brokerage].filter(Boolean);
---

<section class="hero" id="top">
  <div class="hero__frame">
    <SanityImage image={page.heroImage} class="hero__bg" widths={[800, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__content">
      <p class="hero__eyebrow">{credits.map((c) => <span>{c}</span>)}</p>
      <h1><Marks text={page.heroHeadline} /></h1>
      <div class="hero__footer">
        {page.heroSubheadline && <p class="hero__sub">{page.heroSubheadline}</p>}
        <div class="hero__actions">
          <a class="button button--light" href="#contact">{page.ctaLabel || "Get in touch"}<Icon name="arrow-right" /></a>
          {showListingsLink && <a class="button button--ghost" href="#listings">View listings</a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { --frame: clamp(8px, 1vw, 16px); padding-inline: var(--frame); }

  .hero__frame {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: max(560px, calc(100svh - var(--header-height) - var(--frame)));
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-dark);
    color: #fff;
  }

  .hero :global(.hero__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hero :global(.hero__bg.img-placeholder) {
    background:
      radial-gradient(110% 80% at 85% 0%, #46645a 0%, transparent 60%),
      radial-gradient(80% 70% at 0% 100%, #3a3426 0%, transparent 65%),
      linear-gradient(160deg, #24403a, #12201c);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(10 16 14 / 0.8) 0%, rgb(10 16 14 / 0.42) 40%, rgb(10 16 14 / 0) 72%),
      linear-gradient(to right, rgb(10 16 14 / 0.35), rgb(10 16 14 / 0) 65%);
  }

  /* Line up the text with the page sections below the hero. */
  .hero__content {
    padding-inline: max(calc(var(--gutter) - var(--frame)), 1.25rem);
    padding-block: clamp(7rem, 14vh, 10rem) clamp(2rem, 5vw, 4rem);
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1.75rem;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero__eyebrow span { display: inline-flex; align-items: center; gap: 0.875rem; }
  .hero__eyebrow span + span::before { content: ""; width: 1.5rem; height: 1px; background: currentColor; opacity: 0.6; }
  @media (max-width: 600px) {
    .hero__eyebrow { flex-direction: column; align-items: flex-start; gap: 0.375rem; }
    .hero__eyebrow span + span::before { display: none; }
  }

  .hero h1 { max-width: 13ch; margin: 0; text-shadow: 0 2px 40px rgb(0 0 0 / 0.25); }

  .hero__footer {
    display: grid;
    gap: 1.75rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid rgb(255 255 255 / 0.24);
  }
  @media (min-width: 900px) {
    .hero__footer { grid-template-columns: minmax(0, 36rem) auto; justify-content: space-between; align-items: center; }
  }
  .hero__sub { max-width: 42ch; margin: 0; color: rgb(255 255 255 / 0.88); font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem); line-height: 1.55; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__actions .button--ghost {
    --button-bg: rgb(255 255 255 / 0.08);
    --button-border: rgb(255 255 255 / 0.4);
    --button-hover-bg: rgb(255 255 255 / 0.16);
    --button-hover-border: #fff;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero__bg) { animation: hero-settle 2.4s var(--ease) both; }
    .hero__content > * { animation: hero-rise 1.1s var(--ease) both; }
    .hero__content > :nth-child(2) { animation-delay: 0.12s; }
    .hero__content > :nth-child(3) { animation-delay: 0.24s; }
  }
  @keyframes hero-settle { from { transform: scale(1.06); } }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(1.5rem); } }
</style>
