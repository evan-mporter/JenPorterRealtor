---
// Line icons. They inherit the text color and are hidden from screen readers.
const icons = {
  "arrow-right": '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  "arrow-up-right": '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  "arrow-up": '<path d="M12 19.5v-15M6 10.5l6-6 6 6"/>',
  phone: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6.25L20.5 7"/>',
  bed: '<path d="M3 19V6M3 15.5h18M21 19v-6.5a2.5 2.5 0 0 0-2.5-2.5H11v5.5"/><rect x="5.5" y="10.5" width="3.5" height="3" rx="1"/>',
  bath: '<path d="M3.5 12h17v2.5a4.5 4.5 0 0 1-4.5 4.5H8a4.5 4.5 0 0 1-4.5-4.5V12zM6 12V6a2.5 2.5 0 0 1 4.75-1.1M7.5 19l-1 2M16.5 19l1 2"/>',
  area: '<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/>',
};

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
