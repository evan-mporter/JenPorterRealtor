---
import Icon from "./Icon.astro";
import Marks from "./Marks.astro";
import { telHref } from "../lib/sanity";
import type { LandingPage, SiteSettings } from "../lib/types";

interface Props { page: LandingPage; settings: SiteSettings; }
const { page, settings } = Astro.props;
const address = settings.officeAddress?.trim();
---

<section class="section section--dark contact" id="contact">
  <div class="container contact__grid">
    <div class="reveal">
      <p class="eyebrow">Contact</p>
      <h2><Marks text={page.contactHeading || "Let's talk"} /></h2>
      {page.contactBody && <p class="contact__body">{page.contactBody}</p>}
    </div>
    <ul class="contact__list reveal">
      <li>
        <a class="contact__row" href={telHref(settings.phone)}>
          <span class="contact__label">Call</span>
          <span class="contact__value">{settings.phone}</span>
          <Icon name="arrow-up-right" />
        </a>
      </li>
      <li>
        <a class="contact__row" href={`mailto:${settings.email}`}>
          <span class="contact__label">Email</span>
          <span class="contact__value">{settings.email}</span>
          <Icon name="arrow-up-right" />
        </a>
      </li>
      {address && (
        <li>
          <div class="contact__row">
            <span class="contact__label">Office</span>
            <address class="contact__value">{address}</address>
          </div>
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  .contact {
    background:
      radial-gradient(60rem 36rem at 100% 0%, rgb(200 168 116 / 0.14), transparent 60%),
      radial-gradient(40rem 30rem at 0% 100%, rgb(0 0 0 / 0.2), transparent 70%),
      var(--color-dark);
  }
  .contact__grid { display: grid; gap: 3.5rem clamp(3rem, 8vw, 8rem); align-items: end; }
  @media (min-width: 900px) { .contact__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } }

  .contact h2 { margin-bottom: 1.5rem; font-size: clamp(3.25rem, 1.75rem + 6vw, 7.5rem); line-height: 0.95; }
  .contact__body { max-width: 34ch; margin: 0; color: var(--color-on-dark-muted); font-size: 1.1875rem; }

  .contact__list { margin: 0; padding: 0; border-top: 1px solid var(--color-on-dark-border); list-style: none; }
  .contact__list li { border-bottom: 1px solid var(--color-on-dark-border); }
  .contact__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.375rem 1rem;
    padding-block: 1.625rem;
    color: inherit;
    text-decoration: none;
  }
  .contact__label { color: var(--color-accent-soft); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .contact__value { font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); line-height: 1.35; overflow-wrap: anywhere; white-space: pre-line; }
  .contact__row :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-on-dark-muted); transition: transform 0.4s var(--ease), color 0.3s; }
  a.contact__row:hover :global(svg) { color: var(--color-accent-soft); transform: translate(3px, -3px); }

  @media (max-width: 520px) {
    .contact__row { grid-template-columns: minmax(0, 1fr) auto; }
    .contact__label { grid-column: 1 / -1; }
  }
</style>
