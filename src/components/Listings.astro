---
import SanityImage from "./SanityImage.astro";
import { formatPrice } from "../lib/sanity";
import type { LandingPage, Listing } from "../lib/types";

interface Props { page: LandingPage; listings: Listing[]; }
const { page, listings } = Astro.props;
---

{listings.length > 0 && (
  <section class="section" id="listings">
    <div class="container">
      <h2>{page.listingsHeading || "Featured listings"}</h2>
      {page.listingsIntro && <p class="section-intro">{page.listingsIntro}</p>}
      <ul class="listings">
        {listings.map((l) => {
          const facts = [
            l.beds != null && `${l.beds} bd`,
            l.baths != null && `${l.baths} ba`,
            l.sqft != null && `${l.sqft.toLocaleString("en-US")} sq ft`,
          ].filter(Boolean);
          return (
            <li class="card">
              <div class="card__media">
                <SanityImage image={l.photo} widths={[400, 640, 960]} sizes="(min-width: 1000px) 340px, (min-width: 640px) 50vw, 100vw" aspect={3 / 2} class="card__img" />
                {l.status === "pending" && <span class="card__badge">Pending</span>}
              </div>
              <div class="card__body">
                <p class="card__price">{formatPrice(l.price)}</p>
                <h3 class="card__address">
                  {l.link ? <a href={l.link} target="_blank" rel="noopener">{l.address}</a> : l.address}
                </h3>
                <p class="card__city">{l.city}</p>
                {facts.length > 0 && <p class="card__facts">{facts.join(" · ")}</p>}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .listings { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .card { position: relative; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; transition: box-shadow 0.15s; }
  .card:hover { box-shadow: 0 8px 24px rgb(0 0 0 / 0.08); }
  .card__media { position: relative; }
  .card :global(.card__img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .card__badge { position: absolute; top: 12px; left: 12px; padding: 0.2em 0.7em; border-radius: 999px; background: var(--color-badge-pending); color: #fff; font-size: 0.8rem; font-weight: 600; }
  .card__body { padding: 1.1rem 1.25rem 1.3rem; }
  .card__price { font-size: 1.35rem; font-weight: 700; margin: 0 0 0.2rem; }
  .card__address { font-family: var(--font-body); font-size: 1rem; font-weight: 600; margin: 0; }
  .card__address a { color: inherit; text-decoration: none; }
  /* Make the whole card clickable when a link exists. */
  .card__address a::after { content: ""; position: absolute; inset: 0; }
  .card__city, .card__facts { color: var(--color-muted); margin: 0; font-size: 0.95rem; }
  .card__facts { margin-top: 0.5rem; }
</style>
