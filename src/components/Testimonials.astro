---
import Marks from "./Marks.astro";
import type { LandingPage } from "../lib/types";

interface Props { page: LandingPage; }
const { page } = Astro.props;
const items = page.testimonials ?? [];
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

{items.length > 0 && (
  <section class="section section--alt" id="testimonials">
    <div class="container">
      <div class="section-head section-head--center">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2><Marks text={page.testimonialsHeading || "What clients say"} /></h2>
        </div>
      </div>
      <ul class:list={["quotes", { "quotes--single": items.length === 1 }]}>
        {items.map((t) => (
          <li class="reveal">
            <figure class="quote">
              <span class="quote__mark" aria-hidden="true">“</span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
                <span>
                  <span class="quote__name">{t.name}</span>
                  {t.context && <span class="quote__context">{t.context}</span>}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quote {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .quote__mark { height: 2.5rem; color: var(--color-accent); font-family: var(--font-heading); font-size: 5rem; line-height: 1; }
  .quote blockquote { margin: 0 0 2rem; font-family: var(--font-heading); font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem); line-height: 1.3; }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    line-height: 1.35;
  }
  .quote__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-dark);
    color: var(--color-accent-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .quote__name { display: block; font-weight: 600; }
  .quote__context { display: block; color: var(--color-muted); font-size: 0.875rem; }

  /* One testimonial: a large centered quote */
  .quotes--single { grid-template-columns: minmax(0, 54rem); justify-content: center; }
  .quotes--single .quote { padding: 0; background: none; text-align: center; }
  .quotes--single .quote__mark { height: 3.5rem; font-size: 7rem; }
  .quotes--single blockquote { font-size: clamp(1.75rem, 1.1rem + 2.2vw, 2.875rem); line-height: 1.2; }
  .quotes--single figcaption { justify-content: center; border-top: 0; text-align: left; }
</style>
